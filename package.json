{
  "name": "junos-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pet Island - a diegetic phonics and maths island for ages 5-10",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --config vite.island.config.ts",
    "dev:words": "vite --config vite.words.config.ts",
    "build:words": "vite build --config vite.words.config.ts && npm run name:words",
    "name:words": "node -e \"import('node:fs').then(fs=>fs.copyFileSync('dist/words/index.html','dist/words/junos-words.html'))\"",
    "build:island": "vite build --config vite.island.config.ts",
    "build": "npm run build:words && npm run build:island",
    "golden:capture": "node tools/golden/capture.mjs",
    "smoke": "node tools/smoke/boot.mjs",
    "parity": "node tools/smoke/parity.mjs",
    "parity:soak": "node tools/smoke/soak.mjs 50",
    "channel": "node tools/smoke/channel.mjs",
    "workbench": "vite --config vite.workbench.config.ts",
    "workbench:plain": "node tools/workbench/server.mjs",
    "workbench:seed": "node tools/workbench/seed.mjs",
    "pets:atlas": "node tools/pets/atlas.mjs",
    "pets:parts": "node --experimental-strip-types tools/pets/parts-bank.ts",
    "pets:creature": "node --experimental-strip-types --import ./tools/pets/resolve-src.mjs tools/pets/creature.ts",
    "pets:reserve": "node tools/pets/reserve.mjs",
    "pets:reserve:check": "node tools/pets/reserve.mjs --check"
  },
  "devDependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/edu-sa-beginner": "^5.3.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
